{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zorp",
  "version": "0.6.0",
  "identifier": "dev.zorp.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zorp",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Klien API desktop yang ringan",
    "longDescription": "Zorp adalah klien API desktop untuk menyusun, mengirim, dan menguji request HTTP, dengan koleksi, environment, OAuth 2.0, script, dan collection runner.",
    "copyright": "Copyright 2026 Zorp",
    "homepage": "https://github.com/est57/Zorp",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBRDE2Q0FDQzZDRTYzMEMKUldRTVk4N0dyR3pSbWl4bjlFQzQvM0huSGZrbXRIajY2VGpmMVNhUElySnUrb2l6Yi9jdHBwQlYK",
      "endpoints": ["https://github.com/est57/Zorp/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
